# EduGenie Configuration Template
# Copy this file to .env and insert your real Gemini API key

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Recommended Gemini Model (gemini-3.5-flash-lite, gemini-3.8-flash, or gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Local HuggingFace Model Settings
USE_LOCAL_MODEL=False
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M
